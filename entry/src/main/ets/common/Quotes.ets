/** 每日情话：按日期取词，同一天固定为同一句。 */
const QUOTES: string[] = [
  '你是我藏在心里的欢喜，连风都知道。',
  '山海自有归期，风雨自有相逢，而我只想奔向你。',
  '遇见你之后，我所有的运气都用来和你相遇。',
  '想和你把日子过成慢动作，一天一天都是甜的。',
  '喜欢你这件事，我从来没打算停。',
  '你在我身边的时候，风都是柔的。',
  '所谓浪漫，就是和你做很多很多普通的小事。',
  '往后余生，风雪是你，平淡是你，清贫也是你。',
  '我把想说的话都攒着，等见到你的时候一次性说给你听。',
  '今天的月亮很好，但我更想看看你。',
  '你不必完美，你只要是你。',
  '我们绕了一大圈，才发现最好的答案就在彼此身边。',
  '和你在一起的每一天，都值得被记下来。',
  '我认真喜欢你的样子，连我自己都羡慕。',
  '想牵你的手，从清晨走到黄昏。',
  '你要是愿意，我就永远都在。',
  '你笑起来的样子，够我开心一整个星期。',
  '世界很大，但我只想和你占据同一个角落。',
  '看什么都想起你，这大概就是喜欢吧。',
  '我们的故事没有终点，只有下一站。',
  '今天也想被你温柔地喜欢一次。',
  '想和你一起看很多次日落，直到我们都很老。',
  '你不用回头，我一直在你身后。',
  '所有的不期而遇，都是我想见你的借口。',
  '和你说话的时候，时间总是太快。',
  '你是我平淡生活里的那颗糖。',
  '愿我们永远都有说不完的话和吃不完的饭。',
  '如果有一天我们迷路了，就在原地等彼此。',
  '我把今天的心情写下来，标题是你的名字。',
  '喜欢是藏不住的，就像我现在忍不住想你。',
  '我们慢慢来，反正有一辈子的时间。'
];

export function quoteOfDay(seed: number): string {
  const idx: number = Math.abs(Math.floor(seed)) % QUOTES.length;
  return QUOTES[idx];
}
